{
  "name": "bgm.res",
  "title": "bgm.res",
  "version": "0.19.0",
  "description": "bgm.res-A local bangumi manager",
  "buildinf": "Build 2025-04-29 Beta",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "bgm.res",
    "bangumi",
    "local manager"
  ],
  "author": "JimHan",
  "license": "GPL",
  "build": {
    "productName": "bgm.res",
    "appId": "com.Zerolite.bgm-res",
    "copyright": "2025 Zerolite Studio All Rights Reserved.",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "./assets/icons/app.ico",
      "asarUnpack": [
        "src/**",
        "README.md",
        "./mpv"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./install.ico",
      "uninstallerIcon": "./install.ico",
      "installerHeaderIcon": "./assets/icons/app.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "bgm.res"
    }
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "electron-store": "^8.2.0",
    "mica-electron": "^1.5.16",
    "nedb": "^1.8.0"
  }
}
